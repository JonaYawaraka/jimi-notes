---
// 記事の内容に対応した抽象バウハウス・サムネ。ロジックは lib/motif.js に共通化（OGと共用）。
import { buildMotif } from '../lib/motif.js';
const { seed = '', category = '', tags = [], class: klass = '' } = Astro.props;
const { bg, inner, motif } = buildMotif(seed, category, tags, { anim: true });
---
<span class={`jn-thumb ${klass}`} aria-hidden="true" data-motif={motif}>
  <svg viewBox="0 0 320 240" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
    <rect width="320" height="240" fill={bg} />
    <Fragment set:html={inner} />
  </svg>
</span>
