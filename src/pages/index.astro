---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const fmt = (d) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}`;

// draft を除外し、新しい順に
const articles = (await getCollection('articles'))
  .filter((a) => !a.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base
  title={null}
  description="派手なトレンドではなく、毎回マジで困る『地味な急所』を、根拠と実演で解くデザインノート。"
>
  <main class="wrap">
    <section style="padding:64px 0 20px;text-align:center">
      <div class="eyebrow">Design — the boring parts</div>
      <h1>地味だけど本当に困る<br /><span class="grad">デザインの悩み</span>を解く</h1>
      <p class="dim" style="max-width:600px;margin:0 auto">
        影の付け方、余白の決め方、背景に逃げる癖——。派手なトレンドではない「毎回マジで困る急所」を、
        出典付きのリサーチと、コピペできるライブデモで一つずつ潰していくノート。
      </p>
    </section>

    {
      articles.length === 0 ? (
        <p class="dim" style="text-align:center;padding:40px 0">
          まだ公開記事はありません（下書き準備中）。
        </p>
      ) : (
        <div class="cards">
          {articles.map((a) => (
            <a class="acard" href={`/articles/${a.id}/`}>
              <span class="cat">{a.data.category}</span>
              <h3>{a.data.title}</h3>
              <p>{a.data.problem}</p>
              <div class="when">{fmt(a.data.date)}{a.data.sources ? ` ・ ${a.data.sources}ソース裏取り` : ''}</div>
            </a>
          ))}
        </div>
      )
    }
  </main>
</Base>
