---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Thumb from '../components/Thumb.astro';

const fmt = (d) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}`;

const articles = (await getCollection('articles'))
  .filter((a) => !a.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base
  title={null}
  description="派手なトレンドではなく、毎回マジで困る『地味な急所』を、根拠と図版で解くデザインノート。"
>
  <main class="frame">
    <section class="hero">
      <span class="eyebrow">Design — the boring parts</span>
      <h1>地味だけど本当に困る<br /><span class="grad">デザインの悩み</span>を、解く。</h1>
      <div class="hero-foot">
        <p class="lead">
          影の付け方、余白の決め方、背景に逃げる癖——。派手なトレンドではない「毎回マジで困る急所」を、
          出典付きのリサーチと、コピペできる図版で一つずつ潰していくノート。
        </p>
        <p class="count">{articles.length} 記事 / 検証済み</p>
      </div>
    </section>

    {
      articles.length === 0 ? (
        <p class="dim" style="padding:60px 0">まだ公開記事はありません（下書き準備中）。</p>
      ) : (
        <section class="index">
          {articles.map((a, i) => (
            <a class="index-row" href={`/articles/${a.id}/`}>
              <Thumb seed={a.id} category={a.data.category} tags={a.data.tags} class="idx-thumb" />
              <span>
                <span class="cat">{a.data.category} · No.{String(i + 1).padStart(2, '0')}</span>
                <h3>{a.data.title}</h3>
                <p class="desc">{a.data.problem}</p>
                <p class="desc" style="color:var(--ink-3);margin-top:14px;font-size:13px">
                  {fmt(a.data.date)}{a.data.sources ? ` ・ ${a.data.sources}ソース裏取り` : ''}
                </p>
              </span>
              <span class="arrow">→</span>
            </a>
          ))}
        </section>
      )
    }
  </main>
</Base>
