---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Thumb from '../../components/Thumb.astro';

export async function getStaticPaths() {
  const articles = (await getCollection('articles')).filter((a) => !a.data.draft);
  return articles.map((a) => ({
    params: { id: a.id },
    props: { article: a },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const toc = headings.filter((h) => h.depth === 2);

const fmt = (d) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---
<Base
  title={article.data.title}
  description={article.data.problem}
  ogImage={`/og/${article.id}.png`}
>
  <main class="frame" id="main" tabindex="-1">
    <article>
      <header class="article-head full">
        <span class="eyebrow">{article.data.category}</span>
        <h1>{article.data.title}</h1>
        <p class="deck">{article.data.problem}</p>
        <div class="meta-row">
          <span class="chip">{fmt(article.data.date)}</span>
          {article.data.sources && <span class="chip">{article.data.sources}ソース・検証済み</span>}
          {article.data.tags.length > 0 && <span class="chip">{article.data.tags.join(' / ')}</span>}
        </div>
      </header>

      <Thumb seed={article.id} category={article.data.category} tags={article.data.tags} class="article-key" />

      {toc.length > 2 && (
        <nav class="toc" aria-label="目次">
          <span class="toc-h">目次</span>
          <ol>
            {toc.map((h) => (
              <li><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ol>
        </nav>
      )}

      <div class="article-body">
        <Content />
      </div>

      <a class="back" href="/">← 一覧へ戻る</a>
    </article>
  </main>
</Base>
