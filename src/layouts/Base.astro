---
import '../styles/global.css';
const { title, description, ogImage } = Astro.props;
const siteName = 'Jimi Notes';
const SITE = Astro.site ?? new URL('https://jimi-notes.pages.dev');
const canonical = new URL(Astro.url.pathname, SITE).href;
const ogImg = new URL(ogImage ?? '/og-default.png', SITE).href;
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#f4f2ec" />
  <title>{title ? `${title} — ${siteName}` : siteName}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title ?? siteName} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:locale" content="ja_JP" />
  <meta property="og:image" content={ogImg} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title ?? siteName} />
  {description && <meta name="twitter:description" content={description} />}
  <meta name="twitter:image" content={ogImg} />
  <link rel="alternate" type="application/rss+xml" title="Jimi Notes — RSS" href="/rss.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;700;800&family=Noto+Sans+JP:wght@400;700&display=swap"
  />
  <script is:inline>
    // reduced-motion でなければ図解アニメを有効化（描画前に付与してチラつき防止）
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('anim');
  </script>
</head>
<body>
  <a class="skip" href="#main">本文へスキップ</a>
  <header class="site-head">
    <div class="frame">
      <a class="brand" href="/" aria-label="Jimi Notes home">
        <span class="mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span>
          <span class="word">Jimi Notes</span>
          <span class="tag">地味だけど本当に困るデザインの悩み</span>
        </span>
      </a>
      <span class="head-note">Grid-built design notes</span>
    </div>
  </header>

  <slot />

  <footer class="site-foot">
    <div class="frame">
      <span>Jimi Notes — 根拠（リサーチ）＋実演（図版）で、地味な悩みを解く。</span>
      <span>© 2026</span>
    </div>
  </footer>

  <script is:inline>
    if (document.documentElement.classList.contains('anim')) {
      const all = () => document.querySelectorAll('.article-body .demo');
      const showAll = () => all().forEach((el) => el.classList.add('is-in'));
      const reveal = () => {
        try {
          if (!('IntersectionObserver' in window)) return showAll();
          const io = new IntersectionObserver((es) => {
            for (const e of es) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
          }, { threshold: 0.18, rootMargin: '0px 0px -6% 0px' });
          all().forEach((el) => io.observe(el));
          // 保険：何らかで反応しなかった図解は数秒後に必ず表示
          setTimeout(() => all().forEach((el) => { const r = el.getBoundingClientRect(); if (r.top < innerHeight) el.classList.add('is-in'); }), 2500);
        } catch (_) { showAll(); }
      };
      if (document.readyState !== 'loading') reveal(); else addEventListener('DOMContentLoaded', reveal);

      // サムネのアニメは画面内のときだけ動かす（オフスクリーンはCPU節約）
      const initThumbs = () => {
        const thumbs = document.querySelectorAll('.jn-thumb');
        if (!thumbs.length) return;
        if (!('IntersectionObserver' in window)) { thumbs.forEach((t) => t.classList.add('is-anim')); return; }
        const tio = new IntersectionObserver((es) => {
          for (const e of es) e.target.classList.toggle('is-anim', e.isIntersecting);
        }, { rootMargin: '140px' });
        thumbs.forEach((t) => tio.observe(t));
      };
      if (document.readyState !== 'loading') initThumbs(); else addEventListener('DOMContentLoaded', initThumbs);
    }
  </script>
</body>
</html>
